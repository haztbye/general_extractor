# ============================================================
# LLM 配置（必填 LLM_SERVICE_API_KEY，其余有默认值）
# 任选一家 OpenAI 兼容服务，取消注释并填入你的 key
# ============================================================

# ---- 智谱（默认） ----
LLM_SERVICE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_SERVICE_API_KEY=你的key
MODEL_NAME=glm-4-flash

# ---- DeepSeek ----
# LLM_SERVICE_URL=https://api.deepseek.com
# LLM_SERVICE_API_KEY=你的key
# MODEL_NAME=deepseek-chat

# ---- OpenAI ----
# LLM_SERVICE_URL=https://api.openai.com/v1
# LLM_SERVICE_API_KEY=你的key
# MODEL_NAME=gpt-4o-mini

# ---- 本地 Ollama（免key，填任意非空值即可） ----
# LLM_SERVICE_URL=http://localhost:11434/v1
# LLM_SERVICE_API_KEY=ollama
# MODEL_NAME=qwen2.5:7b

# ---- 可选调优 ----
# MAX_TOKEN=500               # 单次抽取的最大生成 token
# MAX_CONCURRENT_REQUESTS=5   # 并发 LLM 请求数
# DEFAULT_TIMEOUT=120         # 单请求超时（秒）
